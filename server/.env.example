# Documents the environment variables required by the backend without including real secrets.
# Copy this file to .env to override the defaults.

# Port the HTTP + Socket.IO server listens on.
PORT=3001

# Origin allowed to connect over Socket.IO (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173

# Gemini API key from Google AI Studio (https://aistudio.google.com -> Get API key).
# Required for Run Tests. Keep the real key in .env only; never commit it or put it in the client.
GEMINI_API_KEY=

# Optional: which Gemini model reviews the code.
GEMINI_MODEL=gemini-3.5-flash-lite
